+def retreat_waypoint(bot, unit, goal, contacts):
+    """Choose a short traversable escape using only currently visible weapons."""
+    origin = unit.position
+    threats = contacts.filter(
+        lambda enemy: (
+            (enemy.can_attack_air if unit.is_flying else enemy.can_attack_ground or enemy.type_id == U.BUNKER)
+            and enemy.distance_to(unit) < max(enemy.ground_range, enemy.air_range) + 18
+        )
+    )
+
+    def traversable(point):
+        area = getattr(bot.game_info, "playable_area", None)
+        if area and not (
+            area.x <= point.x < area.x + area.width and area.y <= point.y < area.y + area.height
+        ):
+            return False
+        if unit.is_flying:
+            return True
+        distance = origin.distance_to(point)
+        return all(
+            bot.in_pathing_grid(origin.towards(point, distance * i / max(1, ceil(distance))))
+            for i in range(1, max(1, ceil(distance)) + 1)
+        )
+
+    if not threats and traversable(goal):
+        return goal
+
+    def danger(point):
+        return sum(
+            max(24 if enemy.type_id == U.BUNKER else 1, enemy.air_dps if unit.is_flying else enemy.ground_dps)
+            * max(
+                0,
+                (
+                    6
+                    if enemy.type_id == U.BUNKER
+                    else enemy.air_range
+                    if unit.is_flying
+                    else enemy.ground_range
+                )
+                + enemy.radius
+                + unit.radius
+                + 3
+                - enemy.distance_to(point),
+            )
+            for enemy in threats
+        )
+
+    direction = atan2(goal.y - origin.y, goal.x - origin.x)
+    distance = min(10, origin.distance_to(goal))
+    candidates = [origin]
+    for i in range(16):
+        angle = direction + i * pi / 8
+        point = origin.offset((cos(angle) * distance, sin(angle) * distance))
+        if traversable(point):
+            candidates.append(point)
+
+    def cost(point):
+        distance = origin.distance_to(point)
+        if distance == 0:
+            return danger(origin) * 8 + origin.distance_to(goal) * 0.15
+        exposure = sum(
+            danger(origin.towards(point, distance * fraction)) for fraction in (0.25, 0.5, 0.75, 1)
+        )
+        return exposure + danger(point) * 4 + point.distance_to(goal) * 0.15
+
+    return min(candidates, key=cost)

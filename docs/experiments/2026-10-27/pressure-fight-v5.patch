+    bot.in_pathing_grid = lambda point: not 3 < point.x < 5
+    goal = Point2((10, 0))
+    assert retreat_waypoint(bot, unit, goal, Units([], bot)).x <= 3
+    flying = make_unit(U.STALKER, is_flying=True)

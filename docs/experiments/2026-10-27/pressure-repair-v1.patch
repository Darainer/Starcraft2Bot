+    waypoint = retreat_waypoint(bot, unit, Point2((30, 0)), Units([enemy], bot))
+    assert waypoint.distance_to(enemy.position) > unit.distance_to(enemy)
+    assert waypoint.distance_to(unit.position) <= 10.001

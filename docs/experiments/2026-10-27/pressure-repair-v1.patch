+import pytest
+from s2clientprotocol import data_pb2
+from sc2.ids.unit_typeid import UnitTypeId as U
+
+from source.combat_assessment import power
+
+
+def test_weapon_bonus_armor_and_observed_upgrades_change_power(bot, make_unit):
+    weapon = bot.game_data.units[U.MARINE.value]._proto.weapons[0]
+    weapon.type, weapon.damage, weapon.attacks, weapon.speed = 1, 10, 1, 2
+    weapon.damage_bonus.add(attribute=2, bonus=4)  # Armored.
+    target_data = bot.game_data.units[U.STALKER.value]._proto
+    target_data.attributes.append(2)
+    target_data.armor = 1
+    attacker = make_unit(U.MARINE, health=100, shield=0)
+    target = make_unit(U.STALKER, health=100, shield=0, armor_upgrade_level=2)
+    assert power([attacker], [target]) == pytest.approx(550)  # (10+4-3)/2 *100HP.
+    upgraded = make_unit(U.MARINE, health=100, shield=0, attack_upgrade_level=2)
+    assert power([upgraded], [target]) == pytest.approx(650)
+    unarmored = make_unit(U.ZEALOT, health=100, shield=0)
+    assert power([attacker], [unarmored]) == pytest.approx(500)
+
+
+def test_shield_armor_and_current_health_weight_are_retained(bot, make_unit):
+    weapon = bot.game_data.units[U.MARINE.value]._proto.weapons[0]
+    weapon.damage, weapon.attacks, weapon.speed = 10, 1, 1
+    attacker = make_unit(U.MARINE, health=40, shield=10)
+    target = make_unit(U.STALKER, shield=100, shield_upgrade_level=3)
+    assert power([attacker], [target]) == pytest.approx(50 * 7)
+
+
+def test_domains_and_dual_domain_colossus_do_not_double_count(bot, make_unit):
+    data = bot.game_data.units[U.MARINE.value]._proto
+    del data.weapons[:]
+    data.weapons.extend(
+        [
+            data_pb2.Weapon(type=1, damage=10, attacks=1, speed=1, range=5),
+            data_pb2.Weapon(type=2, damage=20, attacks=1, speed=1, range=5),
+        ]
+    )
+    attacker = make_unit(U.MARINE, health=100, shield=0)
+    colossus = make_unit(U.COLOSSUS, shield=0)
+    assert power([attacker], [colossus]) == pytest.approx(2000)
+    ground_only = make_unit(U.ZEALOT, health=100, shield=0)
+    bot.game_data.units[U.ZEALOT.value]._proto.weapons[0].type = 1
+    flying = make_unit(U.MUTALISK, is_flying=True)
+    assert power([ground_only], [flying]) == 0
+
+
+def test_unknown_bunker_cargo_remains_conservative_but_unfinished_defense_does_not_attack(bot, make_unit):
+    del bot.game_data.units[U.BUNKER.value]._proto.weapons[:]
+    bunker = make_unit(U.BUNKER, alliance=4, health=100, shield=0)
+    target = make_unit(U.STALKER)
+    assert power([bunker], [target]) >= 2400
+    unfinished = make_unit(U.BUNKER, alliance=4, build_progress=0.5)
+    assert power([unfinished], [target]) == 0
+    assert power([make_unit(U.PROBE)], [target]) == 0
+    assert power([bunker], []) == 0

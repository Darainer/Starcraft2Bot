+def focus_target(unit, targets, assigned_damage):
+    """Use live armor/attribute damage and avoid leaving artillery until last.
+
+    Siege weights are explicit targeting heuristics, not simulated splash DPS.
+    Candidates are already in weapon range: this never orders a pursuit.
+    """
+
+    def score(enemy):
+        remaining = enemy.health + enemy.shield - assigned_damage.get(enemy.tag, 0)
+        damage, speed, _ = unit.calculate_damage_vs_target(enemy)
+        priority = 3 if enemy.type_id == U.SIEGETANKSIEGED else 1.5 if enemy.type_id == U.SIEGETANK else 1
+        volley_time = ceil(max(0, remaining) / max(0.5, damage)) * max(0.1, speed)
+        return (
+            remaining <= 0,
+            not enemy.can_attack,
+            volley_time / priority,
+            unit.distance_to(enemy),
+            enemy.tag,
+        )
+
+    return min(targets, key=score)
 
 

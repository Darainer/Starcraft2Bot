--- /dev/null
+++ b/tests/test_focus_roles.py
@@ -0,0 +1,60 @@
+from s2clientprotocol import data_pb2
+from sc2.ids.unit_typeid import UnitTypeId as U
+
+from source.tactics import TacticalController, focus_target
+
+
+def weapons(bot, kind, damage, attacks, bonus_attribute, bonus):
+    weapon = bot.game_data.units[kind.value]._proto.weapons[0]
+    weapon.damage, weapon.attacks, weapon.speed = damage, attacks, 1
+    del weapon.damage_bonus[:]
+    weapon.damage_bonus.add(attribute=bonus_attribute, bonus=bonus)
+
+
+def opponents(bot, make_unit):
+    marine = make_unit(U.MARINE, (3, 0), alliance=4, health=45, health_max=45, shield=0)
+    tank = make_unit(U.SIEGETANK, (4, 0), alliance=4, health=175, health_max=175, shield=0)
+    for kind, attribute in ((U.MARINE, data_pb2.Light), (U.SIEGETANK, data_pb2.Armored)):
+        data = bot.game_data.units[kind.value]._proto
+        del data.attributes[:]
+        data.attributes.append(attribute)
+    return marine, tank
+
+
+def test_immortal_uses_armor_bonus_and_targets_artillery_instead_of_lowest_hp(bot, make_unit):
+    weapons(bot, U.IMMORTAL, 20, 1, data_pb2.Armored, 30)
+    immortal = make_unit(U.IMMORTAL)
+    marine, tank = opponents(bot, make_unit)
+    assert immortal.calculate_damage_vs_target(tank)[0] > immortal.calculate_damage_vs_target(marine)[0]
+    assert focus_target(immortal, [marine, tank], {}) == tank
+
+
+def test_colossus_retains_efficient_light_target_despite_artillery_priority(bot, make_unit):
+    weapons(bot, U.COLOSSUS, 10, 2, data_pb2.Light, 5)
+    colossus = make_unit(U.COLOSSUS)
+    marine, tank = opponents(bot, make_unit)
+    assert focus_target(colossus, [tank, marine], {}) == marine
+
+
+def test_committed_lethal_volley_redirects_the_next_shooter(bot, make_unit):
+    weapons(bot, U.IMMORTAL, 20, 1, data_pb2.Armored, 30)
+    immortal = make_unit(U.IMMORTAL)
+    marine, tank = opponents(bot, make_unit)
+    assert focus_target(immortal, [marine, tank], {tank.tag: 175}) == marine
+
+
+def test_micro_does_not_chase_distant_artillery_or_take_human_actor(bot, make_unit, populate):
+    weapons(bot, U.IMMORTAL, 20, 1, data_pb2.Armored, 30)
+    immortal = make_unit(U.IMMORTAL)
+    marine, tank = opponents(bot, make_unit)
+    tank._proto.pos.x = 30
+    populate(immortal, marine, tank)
+    bot.settings.attack = True
+    controller = TacticalController()
+    controller.active_mode = "push"
+    assert controller.micro(bot)[0]["action"] == "focus_fire"
+    assert bot.actions[0].target == marine
+    bot._used.clear()
+    bot.actions.clear()
+    immortal._proto.is_selected = True
+    assert controller.micro(bot) == [] and not bot.actions
